{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser.tsbuildinfo",
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/api/**/*",
    "src/App.tsx",
    "src/assets/**/*",
    "src/components/**/*",
    "src/config.tsx",
    "src/connect.tsx",
    "src/formatters.tsx",
    "src/hooks/**/*",
    "src/index.css",
    "src/index.tsx",
    "src/modules/**/*",
    "src/otherTypes.d.ts",
    "src/Routes.tsx",
    "src/RouteUtils.tsx",
    "src/SaladTheme.tsx",
    "src/Storage.tsx",
    "src/Store.tsx",
    "src/Tooltips.tsx",
    "src/utils.tsx"
  ]
}
