@saladtechnologies:registry=https://pkgs.dev.azure.com/SaladTechnologies/_packaging/SaladTechnologies/npm/registry/
# `npm install <pkg>` saves the exact version, not a range: package.json says what is installed, and every upgrade is
# a change to review.
save-exact=true
# A peer dependency conflict fails the install instead of installing a version the dependent was not built for.
strict-peer-deps=true
# Installs only versions published at least 7 days ago, so a compromised release is usually found and pulled before
# it arrives here. A security fix that cannot wait goes in `min-release-age-exclude`, with the reason.
min-release-age=7
